# Server Configuration
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/justus

# Security
JWT_SECRET=your_jwt_secret_key_here

# Push Notifications (VAPID Keys)
# Generate these using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@example.com

# AI Integration
GOOGLE_GEN_AI_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# WebRTC / Calling
# Served to authenticated clients by GET /api/config/webrtc.
# Resolution order: Cloudflare TURN -> static TURN -> STUN only.

# STUN (optional, defaults to Google's public server)
STUN_URL=stun:stun.l.google.com:19302

# --- Tier 1: Cloudflare Realtime TURN (recommended) ---
# Create a TURN key at: Cloudflare dashboard -> Realtime -> TURN -> Create
# The backend exchanges this long-lived key for short-lived client credentials.
# Free tier covers 1,000 GB/month. Never expose these to the browser.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# --- Tier 2: Static TURN fallback (optional, e.g. self-hosted coturn) ---
# Only used when the Cloudflare vars above are unset or the API call fails.
# Requires both TURN_USERNAME and TURN_CREDENTIAL to be set.
TURN_URL=
TURN_URL_TCP=
TURN_URL_443=
TURNS_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Third Party
# Add any other service keys here
